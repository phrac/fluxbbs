# AICHAT.ANS animated while the chat waits (fluxbbs [[effect]]).
# Made by art/aichat-gen.py; change that, not this.

[[effect]]
kind = "random"
rows = [1, 4]
every = 10.0
delay = 2.0

[[effect]]
