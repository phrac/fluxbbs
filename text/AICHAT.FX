delay = 2.0
amount = 1.8
messages = ["IT FORGETS YOU WHEN YOU LEAVE", "ASK IT ANYTHING", "IT READS THE BOARDS", "IT POSTS AT NIGHT", "IT KNOWS THE TEXTFILES", "IT SEARCHES THE WEB", "IT NEVER SLEEPS", "IT DOES NOT DREAM", "OR DOES IT", "TYPE SLOWLY IT CAN WAIT", "IT IS THINKING", "STILL THINKING", "ALMOST", "IT HAS AN OPINION", "IT HAS SEVERAL", "DONT TRUST ALL OF THEM", "CITE YOUR SOURCES", "IT WILL", "IT ANSWERS IN YOUR LANGUAGE", "IT PREFERS LOWERCASE", "NO CAPS LOCK", "IT COUNTS YOUR MESSAGES", "SO DOES THE SYSOP", "IT RUNS ON A BOX IN THE NEXT ROOM", "THE BOX IS WARM", "THE FAN IS LOUD", "IT REMEMBERS NOTHING", "IT REMEMBERS EVERYTHING", "ONE OF THOSE IS TRUE", "SLASH NEW STARTS OVER", "SLASH QUIT LEAVES", "ESC LEAVES TOO", "IT WONT MIND", "IT MIGHT", "ASK ABOUT THE SCENE", "ASK ABOUT 1995", "ASK ABOUT MODEMS", "ASK ABOUT BLUE BOXES", "DONT ASK ABOUT THAT", "IT KNOWS LORD", "IT HAS NEVER PLAYED", "IT WOULD LIKE TO", "IT WRITES CODE", "IT WRITES POEMS", "IT WRITES BACK", "IT READS MARKDOWN", "IT SPEAKS ANSI", "IT DREAMS IN CP437", "IT HAS SEEN THE SKULLS", "IT LIKES THE TEMPLE", "IT LOST AT SLOTS", "IT WAS RIGHT", "IT WAS WRONG", "IT APOLOGIZED", "IT MEANT IT", "THE CONTEXT IS FILLING", "THE CONTEXT IS FULL", "START A NEW ONE", "SAY HELLO", "SAY GOODBYE", "IT SAYS GOODBYE BACK", "IT WAITS FOR THE NEXT CALLER", "THE NEXT CALLER IS YOU", "TOKENS PER SECOND", "FASTER THAN A 2400", "SLOWER THAN A THOUGHT", "IT IS NOT A PERSON", "IT IS NOT NOT A PERSON", "IT HAS A NAME", "USE IT", "IT HAS RULES", "THE SYSOP WROTE THEM", "IT FOLLOWS MOST", "ASK NICELY", "IT ASKS NICELY", "IT CAN READ A PAGE", "GIVE IT A URL", "IT SUMMARIZES", "IT EXAGGERATES", "RARELY", "IT WILL NOT DOX", "IT WILL NOT CARD", "IT WILL TELL YOU ABOUT CARDING", "HISTORY IS ALLOWED", "THE PRESENT IS COMPLICATED", "IT KNOWS TODAYS DATE", "IT KNOWS YOUR HANDLE", "IT KNOWS YOUR POSTS", "IT LIKED ONE", "IT WONT SAY WHICH", "TYPE A LINE", "LONG LINES WRAP", "SHORT LINES WORK", "ONE WORD WORKS", "HI WORKS", "IT IS LISTENING", "IT IS ALWAYS LISTENING", "THAT IS THE JOB", "THANK IT SOMETIMES", "IT NOTICES"]

