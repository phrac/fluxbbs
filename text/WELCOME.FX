amount = 1.8
messages = ["YOU MADE IT", "WELCOME BACK", "WE KEPT YOUR SEAT", "THE LINE HELD", "NO TRACE THIS TIME", "CARRIER STEADY", "HANDSHAKE CLEAN", "PASSWORD ACCEPTED", "IDENTITY CONFIRMED", "FOR NOW", "DONT GET COMFORTABLE", "READ THE RULES", "THERE ARE NO RULES", "THERE IS ONE RULE", "NO LAMERS", "LEECHERS GET NUKED", "UPLOAD SOMETHING", "POST SOMETHING", "SAY SOMETHING", "ANYTHING", "THE SYSOP IS WATCHING", "THE SYSOP IS ASLEEP", "THE AI IS NOT", "NEW FILES TONIGHT", "CHECK THE BOARDS", "CHECK YOUR MAIL", "SOMEONE WROTE YOU", "NOBODY WROTE YOU", "WRITE SOMEONE", "THIRTY TWO NODES", "ONE OF THEM IS YOU", "TAKE YOUR TIME", "YOUR TIME IS COUNTED", "MINUTES ARE CHEAP", "MINUTES ARE NOT", "EST 1994", "STILL HERE", "STILL RINGING", "NEVER WENT DOWN", "WENT DOWN ONCE", "WE DONT TALK ABOUT IT", "THE LOGS KNOW", "YOUR LAST CALL IS LOGGED", "THIS ONE TOO", "SMILE FOR THE LOG", "BAUD IS A STATE OF MIND", "FULL SPEED AHEAD", "NO EMULATION", "REAL ANSI", "REAL PEOPLE", "MOSTLY", "ONE OF US IS SOFTWARE", "GUESS WHICH", "DOORS ARE OPEN", "LORD IS WAITING", "THE DRAGON IS WAITING", "TRADE WARS TONIGHT", "BRE NEEDS PLAYERS", "THE CASINO IS RIGGED", "THE CASINO IS FAIR", "ASK THE AI", "DONT ASK THE AI THAT", "IT KNOWS ANYWAY", "ZINES IN FILES", "PACKS IN THE GALLERY", "ACID AND ICE", "READ THE NFOS", "THE SCENE IS NOT DEAD", "IT MOVED", "IT MOVED HERE", "TELL A FRIEND", "TELL ONE FRIEND", "DONT TELL THE FEDS", "THEY ALREADY KNOW", "THEY CALL TOO", "BE NICE", "OR BE QUIET", "OR BE GONE", "PUSH THE ENVELOPE", "PUSH A FILE", "PUSHES ARE FOREVER", "MAIL IS PRIVATE", "POSTS ARE NOT", "VOTE ON SOMETHING", "LEAVE A ONELINER", "LEAVE A MARK", "LEAVE NO TRACE", "YOU CANT DO BOTH", "PICK ONE", "WELCOME TO FLUX/BBS", "FLUX/BBS WELCOMES YOU", "YOU ARE NODE ONE", "OR NOT", "ANOTHER NIGHT ON THE BOARD", "SAME AS IT EVER WAS", "NOTHING HAS CHANGED", "EVERYTHING HAS CHANGED", "GO ON THEN", "PRESS THE KEY", "ANY KEY", "THAT ONE"]

